# ==============================================================================
# Cybersecurity Incident Triage AI - Backend Environment Template
# Copy this file to .env and provide your configuration.
# Never commit the actual .env file with real secrets to version control.
# ==============================================================================

# Google Gemini API Configuration (Used for RAG embeddings and optional Gemini triage synthesis)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here

# LLM Provider Configuration ('xkiro' or 'gemini', default: gemini)
LLM_PROVIDER=xkiro

# xKiro API Configuration (Used when LLM_PROVIDER=xkiro)
XKIRO_API_KEY=your_xkiro_api_key_here
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=qwen/qwen3.5-flash:free

# Gemini Model Identifier (Used when LLM_PROVIDER=gemini)
GEMINI_MODEL=gemini-3.6-flash

# RAG Embedding Configuration (Google Gemini Embeddings for low-memory deployment)
RAG_EMBEDDING_MODEL=models/gemini-embedding-001
RAG_EMBEDDING_DIMENSION=768

# CORS Allowed Origins (Comma-separated list of origins permitted to call the API)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional: Abuse.ch Threat Intelligence API Key (For elevated rate limits)
ABUSE_CH_API_KEY=
